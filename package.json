{
    "name": "@triplestepab/all-the-cities",
    "author": {
        "name": "Tomas Nilsson",
        "email": "contact@triplestep.se"
    },
    "version": "1.0.18",
    "license": "MIT",
    "main": "bin/index.js",
    "type": "module",
    "scripts": {
        "dev": "./node_modules/.bin/tsc -b -v && node --inspect ./bin/index.js",
        "build": "./node_modules/.bin/tsc -b -v",
        "clean": "./node_modules/.bin/rimraf ./src/**/bin ./bin ./src/**/tsconfig.tsbuildinfo tsconfig.tsbuildinfo",
        "rebuild": "npm run clean && npm run build",
        "build:diag": "./node_modules/.bin/tsc -b -v -w --preserveWatchOutput -watch --extendedDiagnostics",
        "lint": "./node_modules/.bin/eslint \"./src/**/**.ts\"",
        "test": "mocha",
        "tsc-watch": "./node_modules/.bin/tsc-watch -b -v -i -w --noclear --compiler \"./node_modules/.bin/tsc\" --onSuccess \"node --inspect --es-module-specifier-resolution=node ./bin/index.js\""
    },
    "overrides": {
        "--minimatch-is-to-resolve-a-vunerability-remove-if-fixed-after-2026-02-21": "v0.0.0",
        "minimatch": "^10.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.3.0",
        "chai": "^6.2.2",
        "eslint": "^10.0.1",
        "globals": "^17.3.0",
        "mocha": "^11.7.5",
        "rimraf": "^6.1.3",
        "tsc-watch": "^7.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0"
    }
}
